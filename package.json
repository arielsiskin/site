{
  "name": "mayday-site",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local ./node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "check": "tsc --noEmit && node --experimental-strip-types src/lib/qiq.check.ts && node --experimental-strip-types src/lib/mis.check.ts && node --experimental-strip-types src/lib/ratelimit.check.ts && node --experimental-strip-types src/lib/voicebot.check.ts && node --experimental-strip-types voice-agent/src/farewell.check.ts"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/urbanist": "^5.3.0",
    "astro": "7.4.5",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
