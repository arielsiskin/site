---
import Layout from "@/layouts/Layout.astro";
import { Aurora, Eyebrow, Glow, PillLink } from "@/components/ui";
import { ContactForm } from "@/components/ContactForm";
import { DEMO_WHATSAPP_URL, OFFICES, PHONES } from "@/lib/utils";
---

<Layout title="Contacto | Mayday Global" description="Escribinos y te mostramos en 30 minutos cómo el hub de Mayday Global puede ayudar a tu contact center.">
  <section id="contacto" class="relative overflow-hidden bg-md-sky pb-24 pt-36 md:pt-44">
    <Aurora className="top-1/3" />
    <div class="relative mx-auto max-w-6xl px-4">
      <Eyebrow>Contacto</Eyebrow>
      <h1 class="mt-4 max-w-3xl font-display text-[44px] font-extrabold leading-[1.02] tracking-tight text-md-ink md:text-[68px]">
        Hablemos de tu <Glow>operación</Glow>.
      </h1>
      <p class="mt-6 max-w-xl text-md-muted md:text-lg">Contanos qué querés resolver y te mostramos todas nuestras aplicaciones en 30 minutos.</p>

      <div class="mt-12 grid items-start gap-10 lg:grid-cols-[1.5fr_1fr]">
        <ContactForm client:visible />
        <div class="space-y-8">
          <div>
            <p class="text-sm font-semibold text-md-ink">¿Preferís WhatsApp?</p>
            <div class="mt-3"><PillLink href={DEMO_WHATSAPP_URL} variant="light">Escribinos por WhatsApp</PillLink></div>
          </div>
          {
            OFFICES.map(([city, country, addr]) => (
              <div class="border-l-2 border-md-cyan pl-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-md-muted">{country}</p>
                <p class="mt-1 font-display text-xl font-bold text-md-ink">{city}</p>
                <p class="mt-1 text-sm text-md-muted">{addr}</p>
                {PHONES.filter((p) => p.country === country).map((p) => (
                  <a href={`tel:${p.tel}`} class="mt-1 inline-block py-1 text-sm font-semibold text-md-ink underline-offset-4 hover:underline">{p.label}</a>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Layout>
