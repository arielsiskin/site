---
import Layout from "@/layouts/Layout.astro";
import { Aurora, Eyebrow, Glow, PillLink, Reveal } from "@/components/ui";
import { DEMO_WHATSAPP_URL } from "@/lib/utils";

const reasons = [
  {
    title: "Soluciones integrales y a medida",
    body: "No solo ofrecemos tecnología: diseñamos soluciones estratégicas para resolver los desafíos de tu operación y acelerar tu crecimiento.",
    img: "/assets/about-us/image-1.png",
  },
  {
    title: "Equipo experto y cercano",
    body: "Somos más que proveedores: somos socios que trabajan codo a codo con tu equipo para co-crear soluciones que realmente impacten.",
    img: "/assets/about-us/image-2.png",
  },
  {
    title: "Calidad de punta a punta",
    body: "La excelencia de nuestras herramientas se acompaña de una implementación ágil y un servicio postventa personalizado y eficiente.",
    img: "/assets/about-us/image-3.png",
  },
];
const values = ["Innovación constante", "Compromiso con la excelencia", "Trabajo en equipo", "Orientación al cliente", "Integridad y transparencia"];
const offices = [
  ["Buenos Aires", "Gorostiaga 2355 Of. 802, CABA"],
  ["Ciudad de México", "Calle Avellano 12, Santa María la Ribera, Cuauhtémoc"],
  ["Asunción", "Av. Aviadores del Chaco 2050"],
  ["Miami", "201 Collins Av. Apt 1226, Miami Beach 33139"],
];
---

<Layout title="Nosotros | Mayday Global" description="Somos un equipo apasionado por crear soluciones tecnológicas que transforman la experiencia del cliente en América Latina.">
  <section class="relative overflow-hidden bg-md-sky pb-24 pt-40 text-center md:pt-48">
    <Aurora className="top-1/2" />
    <div class="relative mx-auto max-w-4xl px-4">
      <Eyebrow>Nosotros</Eyebrow>
      <h1 class="mt-4 font-display text-[44px] font-extrabold leading-[1.02] tracking-tight text-md-ink md:text-[72px]">
        Tecnología que <Glow>transforma</Glow> la atención al cliente.
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-md-muted md:text-lg">
        Somos un equipo apasionado por crear soluciones para contact centers. Más de 50 clientes en 10 países confían en nosotros.
      </p>
    </div>
  </section>

  <section class="bg-white py-24">
    <div class="mx-auto max-w-6xl space-y-20 px-4">
      {
        reasons.map((r, i) => (
          <Reveal className={`grid items-center gap-10 md:grid-cols-2 ${i % 2 ? "md:[&>*:first-child]:order-2" : ""}`}>
            <div>
              <p class="font-data text-sm text-md-cyan-dark">0{i + 1}</p>
              <h2 class="mt-2 font-display text-3xl font-extrabold tracking-tight text-md-ink md:text-5xl">{r.title}</h2>
              <p class="mt-4 text-md-muted md:text-lg">{r.body}</p>
            </div>
            <div class="overflow-hidden rounded-[28px] bg-md-bg">
              <img src={r.img} alt="" loading="lazy" class="h-full w-full object-cover" />
            </div>
          </Reveal>
        ))
      }
    </div>
  </section>

  <section class="bg-md-navy py-24 text-white">
    <div class="mx-auto grid max-w-6xl gap-4 px-4 md:grid-cols-3">
      <Reveal className="rounded-[24px] border border-white/10 bg-white/[0.04] p-8">
        <p class="text-sm text-md-cyan">Misión</p>
        <p class="mt-3 text-lg leading-relaxed">
          Transformar la experiencia de atención al cliente con soluciones tecnológicas que potencien la relación entre empresas y sus clientes.
        </p>
      </Reveal>
      <Reveal delay={0.08} className="rounded-[24px] border border-white/10 bg-white/[0.04] p-8">
        <p class="text-sm text-md-cyan">Visión</p>
        <p class="mt-3 text-lg leading-relaxed">
          Ser líderes en la región en experiencia del cliente, reconocidos por nuestra innovación, calidad y compromiso con el éxito de cada cliente.
        </p>
      </Reveal>
      <Reveal delay={0.16} className="rounded-[24px] border border-white/10 bg-white/[0.04] p-8">
        <p class="text-sm text-md-cyan">Valores</p>
        <ul class="mt-3 space-y-2 text-lg">{values.map((v) => <li>{v}</li>)}</ul>
      </Reveal>
    </div>
  </section>

  <section class="bg-white py-24">
    <div class="mx-auto max-w-6xl px-4">
      <Eyebrow>Dónde estamos</Eyebrow>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          offices.map(([city, addr]) => (
            <div class="rounded-[20px] border border-md-line p-6">
              <p class="font-display text-xl font-bold text-md-ink">{city}</p>
              <p class="mt-2 text-sm text-md-muted">{addr}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-12 flex justify-center"><PillLink href={DEMO_WHATSAPP_URL}>Hablemos</PillLink></div>
    </div>
  </section>
</Layout>
