---
import Layout from "@/layouts/Layout.astro";
import { Aurora, Eyebrow, Glow, Reveal } from "@/components/ui";
import { Closing } from "@/components/Sections";
import { ContactForm } from "@/components/ContactForm";
import { OFFICES, PHONES } from "@/lib/utils";

// Editorial layout (no stock photos): facts up front, what sets us apart, mission/vision/values, partners, offices.
const facts = [
  ["50+", "clientes en la región"],
  ["10", "países"],
  ["4.100+", "usuarios en nuestra plataforma"],
  ["3", "oficinas"],
];
const reasons = [
  ["Soluciones integrales y a medida", "No solo ofrecemos tecnología: diseñamos soluciones estratégicas para resolver los desafíos de tu operación y acelerar tu crecimiento."],
  ["Equipo experto y cercano", "Somos más que proveedores: somos socios que trabajan codo a codo con tu equipo para co-crear soluciones que realmente impacten."],
  ["Calidad de punta a punta", "La excelencia de nuestras herramientas se acompaña de una implementación ágil y un servicio postventa personalizado y eficiente."],
];
const values = ["Innovación constante", "Compromiso con la excelencia", "Trabajo en equipo", "Orientación al cliente", "Integridad y transparencia"];
// Heights tuned by eye so the logos weigh the same (their aspect ratios go from 3.5:1 to 6.3:1).
const partners = [
  ["Botmaker", "/assets/brands/botmaker.svg", 26],
  ["Neotel", "/assets/brands/neotel.svg", 30],
  ["Collaborix", "/assets/brands/collaborix.svg", 30],
  ["Vocalcom", "/assets/brands/vocalcom.svg", 21],
] as const;
const offices = OFFICES;
---

<Layout title="Nosotros | Mayday Global" description="Somos un equipo apasionado por crear soluciones tecnológicas que transforman la experiencia del cliente en América Latina.">
  <section class="relative overflow-hidden bg-md-sky pb-16 pt-36 md:pt-44">
    <Aurora className="top-1/2" />
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 md:grid-cols-[1.4fr_1fr]">
      <div>
        <Eyebrow>Nosotros</Eyebrow>
        <h1 class="mt-4 font-display text-[44px] font-extrabold leading-[1.02] tracking-tight text-md-ink md:text-[68px]">
          Tecnología que <Glow>transforma</Glow> la atención al cliente.
        </h1>
        <p class="mt-6 max-w-xl text-md-muted md:text-lg">
          Somos un equipo apasionado por crear soluciones para contact centers de América Latina: agentes de IA, calidad, omnicanalidad y datos,
          conectados en un solo hub.
        </p>
      </div>
      <img src="/assets/brands/ISO.png" alt="" class="mx-auto w-48 opacity-90 md:w-full md:max-w-[320px]" />
    </div>
    <dl class="relative mx-auto mt-16 grid max-w-6xl grid-cols-2 gap-y-8 px-4 md:grid-cols-4">
      {
        facts.map(([n, l]) => (
          <div class="flex flex-col-reverse border-l border-md-ink/15 pl-5">
            <dt class="mt-1 text-sm text-md-muted">{l}</dt>
            <dd class="font-display text-4xl font-extrabold text-md-ink md:text-5xl">{n}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="bg-white py-24 md:py-32">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 md:grid-cols-[1fr_2fr]">
      <div>
        <Eyebrow>Qué nos diferencia</Eyebrow>
        <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-md-ink md:text-5xl">Socios, no proveedores.</h2>
      </div>
      <div class="divide-y divide-md-line border-y border-md-line">
        {
          reasons.map(([t, b], i) => (
            <Reveal className="grid gap-2 py-8 md:grid-cols-[4rem_1fr]">
              <p class="font-data text-sm text-md-cyan-dark">0{i + 1}</p>
              <div>
                <h3 class="font-display text-2xl font-extrabold text-md-ink">{t}</h3>
                <p class="mt-2 text-md-muted md:text-lg">{b}</p>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-md-bg py-24 md:py-32">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid gap-12 md:grid-cols-2">
        <Reveal>
          <p class="font-data text-sm uppercase tracking-wider text-md-cyan-dark">Misión</p>
          <p class="mt-4 font-display text-2xl font-bold leading-snug text-md-ink md:text-3xl">
            Transformar la experiencia de atención al cliente con soluciones tecnológicas que potencien la relación entre empresas y sus clientes.
          </p>
        </Reveal>
        <Reveal delay={0.08}>
          <p class="font-data text-sm uppercase tracking-wider text-md-cyan-dark">Visión</p>
          <p class="mt-4 font-display text-2xl font-bold leading-snug text-md-ink md:text-3xl">
            Ser líderes en la región en experiencia del cliente, reconocidos por nuestra innovación, calidad y compromiso con el éxito de cada cliente.
          </p>
        </Reveal>
      </div>
      <p class="mt-16 font-data text-sm uppercase tracking-wider text-md-cyan-dark">Valores</p>
      <ul class="mt-4 flex flex-wrap gap-3">
        {values.map((v) => <li class="rounded-full border border-md-line bg-white px-5 py-2.5 font-medium text-md-ink">{v}</li>)}
      </ul>
    </div>
  </section>

  <section class="bg-white py-24">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid gap-14 md:grid-cols-[1.6fr_1fr]">
        <div>
          <Eyebrow>Partners y tecnología</Eyebrow>
          <div class="mt-8 flex flex-wrap items-center gap-x-10 gap-y-8">
            {partners.map(([name, src, h]) => <img src={src} alt={name} style={`height:${h}px`} class="w-auto opacity-70 brightness-0" />)}
          </div>
        </div>
        <div>
          <Eyebrow>Infraestructura</Eyebrow>
          <div class="mt-8 flex flex-wrap gap-3">
            {["Google Cloud", "Microsoft Azure"].map((c) => <span class="rounded-full bg-md-sky px-5 py-2.5 font-display font-bold text-md-ink">{c}</span>)}
          </div>
          <p class="mt-3 text-sm text-md-muted">Nuestras soluciones corren sobre GCP y Azure.</p>
        </div>
      </div>

      <div class="mt-24 grid items-center gap-12 md:grid-cols-[1.2fr_1fr]">
        <div class="relative mx-auto aspect-[980/1080] w-full max-w-md">
          <img src="/assets/map/americas.svg" alt="Mapa de América con las oficinas de Mayday Global" class="absolute inset-0 h-full w-full [mask-image:linear-gradient(to_bottom,transparent,black_30%)]" />
          {
            offices.map(([city, , , x, y]) => (
              <span class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${x}%;top:${y}%`}>
                <span class="absolute inset-0 animate-ping rounded-full bg-md-cyan/60 motion-reduce:hidden" />
                <span class="relative block size-4 rounded-full border-[3px] border-white bg-md-cyan shadow-[0_0_0_2px_#010136]" />
                <span class="absolute left-6 top-1/2 -translate-y-1/2 whitespace-nowrap rounded-full bg-md-navy px-2.5 py-1 text-xs font-semibold text-white">{city}</span>
              </span>
            ))
          }
        </div>
        <div>
          <Eyebrow>Dónde estamos</Eyebrow>
          <div class="mt-6 space-y-8">
            {
              offices.map(([city, country, addr]) => (
                <div class="border-l-2 border-md-cyan pl-5">
                  <p class="text-xs font-semibold uppercase tracking-wider text-md-muted">{country}</p>
                  <p class="mt-1 font-display text-xl font-bold text-md-ink">{city}</p>
                  <p class="mt-1 text-sm text-md-muted">{addr}</p>
                  {PHONES.filter((p) => p.country === country).map((p) => (
                    <a href={`tel:${p.tel}`} class="mt-1 inline-block text-sm font-semibold text-md-ink underline-offset-4 hover:underline">{p.label}</a>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <Closing><ContactForm client:visible /></Closing>
</Layout>
