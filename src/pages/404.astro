---
import Layout from "@/layouts/Layout.astro";
import { Aurora, Eyebrow, Glow } from "@/components/ui";
---

<Layout title="Página no encontrada | Mayday Global" description="La página que buscás no existe o cambió de dirección.">
  <section class="relative overflow-hidden bg-md-sky pb-32 pt-40 text-center md:pb-40 md:pt-48">
    <Aurora className="top-1/2" />
    <div class="relative mx-auto max-w-3xl px-4">
      <Eyebrow>Error 404</Eyebrow>
      <h1 class="mt-4 font-display text-[44px] font-extrabold leading-[1.02] tracking-tight text-md-ink md:text-[72px]">
        Esta página <Glow>no existe</Glow>.
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-md-muted md:text-lg">
        Puede que el link esté mal escrito o que la página haya cambiado de dirección. Todas nuestras soluciones están en la home, y
        se pueden probar en vivo.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/" class="rounded-full bg-md-navy px-6 py-3 text-sm font-semibold text-white transition hover:bg-md-indigo">Ir al inicio</a>
        <a href="/#soluciones" class="rounded-full border border-md-line bg-white px-6 py-3 text-sm font-semibold text-md-ink transition hover:border-md-blue">
          Ver las soluciones
        </a>
      </div>
    </div>
  </section>
</Layout>
