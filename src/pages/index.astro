---
import Layout from "@/layouts/Layout.astro";
import { Hero } from "@/components/Hero";
import { AgenticDemo } from "@/components/AgenticDemo";
import { QualityDemo } from "@/components/QualityDemo";
import { OmniDemo } from "@/components/OmniDemo";
import { MisDemo } from "@/components/MisDemo";
import { Closing, Faq, Numbers } from "@/components/Sections";
import { ContactForm } from "@/components/ContactForm";
import { Solutions } from "@/components/Hub";
---

<Layout
  title="Mayday Global | Hub de soluciones con IA para contact centers"
  description="Hub de soluciones para contact centers de América Latina: agentes de IA por voz y WhatsApp, QualityIQ, Omnichannel y MIS conectados. Probá cada solución en vivo."
>
  <Hero client:load />
  <Solutions client:visible />
  <AgenticDemo client:visible />
  <QualityDemo client:visible />
  <OmniDemo client:visible />
  <MisDemo client:visible />
  <Numbers client:visible />
  <Faq />
  <Closing><ContactForm client:visible /></Closing>
</Layout>
