---
import Layout from "@/layouts/Layout.astro";
import { Hero } from "@/components/Hero";
import { VoiceDemo } from "@/components/VoiceDemo";
import { VoiceScreens } from "@/components/VoiceScreens";
import { QualityDemo } from "@/components/QualityDemo";
import { OmniDemo } from "@/components/OmniDemo";
import { BotDemo } from "@/components/BotDemo";
import { MisDemo } from "@/components/MisDemo";
import { Closing, Faq, Numbers } from "@/components/Sections";
import { Solutions } from "@/components/Hub";
---

<Layout
  title="Mayday Global | Hub de soluciones con IA para contact centers"
  description="Hub de soluciones para contact centers de América Latina: voicebots, QualityIQ, IA Bot, Omnichannel y MIS conectados. Probá cada solución en vivo."
>
  <Hero client:load />
  <Solutions />
  <VoiceDemo client:visible />
  <VoiceScreens client:visible />
  <QualityDemo client:visible />
  <OmniDemo client:visible />
  <BotDemo client:visible />
  <MisDemo client:visible />
  <Numbers client:visible />
  <Faq />
  <Closing />
</Layout>
